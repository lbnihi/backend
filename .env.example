# Database — paste EasyPanel's *internal* connection URL as-is (postgres://, ?sslmode=... are handled).
DATABASE_URL=postgres://qalbalkhalij:YOUR_DB_PASSWORD@qalbalkhalij_database:5432/qalbalkhalij?sslmode=disable

# CORS (comma-separated)
CORS_ORIGINS=https://qaalbalkhalij.store,https://www.qaalbalkhalij.store

# Used as event_source_url fallback for CAPI
SITE_URL=https://qaalbalkhalij.store

# MaxMind GeoIP2 Insights web service (KSA-only check on every order; VPN users in KSA are allowed)
# maxmind.com → Account → "Manage License Keys". Insights needs prepaid credits.
MAXMIND_ACCOUNT_ID=123456
MAXMIND_LICENSE_KEY=your_maxmind_license_key
# false = refuse orders when MaxMind is down / out of credits (strict). true = let them through.
MAXMIND_FAIL_OPEN=false
MAXMIND_TIMEOUT_SECONDS=5

# Google Sheets Webhook
SHEETS_WEBHOOK_URL=

# COD Network call center (seller API v2). Token: Seller portal > My profile > API developer > API Token.
CODNETWORK_API_TOKEN=
# product slug:COD Network SKU, comma-separated. Products without a SKU are not sent.
CODNETWORK_SKUS=hyaluronic-acid:MP-OHVNOQLIBYO8
# true only to test the connection with WHITELISTED_PHONES (the call center will see these test leads)
CODNETWORK_SEND_TEST_ORDERS=false

# Facebook CAPI
FB_PIXEL_ID=
FB_ACCESS_TOKEN=

# TikTok CAPI
TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=

# Snapchat CAPI
SNAP_PIXEL_ID=
SNAP_ACCESS_TOKEN=

# Whitelisted phones for test orders in production (comma-separated) — bypass MaxMind and rate limits
WHITELISTED_PHONES=0550000000

# Rate limiting (orders per IP per hour / per phone per day)
ORDER_RATE_LIMIT_PER_IP=10
ORDER_RATE_LIMIT_PER_PHONE=3

# Uvicorn workers. Keep 1: rate limits are kept in memory per process.
WEB_CONCURRENCY=1

# docker-compose only (local Postgres)
DB_USER=postgres
DB_PASSWORD=postgres

# Admin dashboard (/admin). Stays locked until all three are set.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# 32+ random characters, e.g. output of: openssl rand -hex 32
ADMIN_JWT_SECRET=
